rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate String Length
    function isValidString(text, min, max) {
      return text is string && text.size() >= min && text.size() <= max;
    }

    // Validate Optional String (allows null or string within limits)
    function isOptionalString(text, max) {
      return text == null || (text is string && text.size() <= max);
    }

    // Validate follow/follower snapshot docs
    function isValidFollowSnapshot() {
      return request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'followedAt'])
             && isValidString(request.resource.data.displayName, 1, 100)
             && isOptionalString(request.resource.data.photoURL, 2000)
             && request.resource.data.followedAt == request.time;
    }

    function isValidStudioFavorite(studioId) {
      return request.resource.data.keys().hasOnly(['id', 'mal_id', 'name', 'image', 'addedAt'])
             && request.resource.data.id == studioId
             && request.resource.data.mal_id == studioId
             && isValidString(request.resource.data.id, 1, 120)
             && isValidString(request.resource.data.name, 1, 120)
             && isOptionalString(request.resource.data.image, 2000)
             && request.resource.data.addedAt == request.time;
    }

    // Both sides of a follow relation must be created or deleted atomically.
    function followPairExists(followerUid, targetUid) {
      return existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid))
             && existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid));
    }

    function followPairIsDeleted(followerUid, targetUid) {
      return !existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid))
             && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid));
    }

    // Validate notification type
    function isValidNotificationType(type) {
      return type in ['profile_view', 'comment_like', 'new_follower'];
    }

    // Validate notification payloads created by authenticated actors
    function isValidNotificationCreate(targetUserId) {
      return request.resource.data.keys().hasOnly([
               'type', 'actorUid', 'actorName', 'actorAvatar',
               'content', 'link', 'animeId', 'animeTitle',
               'read', 'createdAt'
             ])
             && request.auth.uid != targetUserId
             && request.resource.data.actorUid == request.auth.uid
             && request.resource.data.read == false
             && request.resource.data.createdAt == request.time
             && isValidNotificationType(request.resource.data.type)
             && isValidString(request.resource.data.content, 1, 300)
             && isOptionalString(request.resource.data.actorName, 100)
             && isOptionalString(request.resource.data.actorAvatar, 2000)
             && isOptionalString(request.resource.data.link, 200)
             && (
               (
                 request.resource.data.type in ['profile_view', 'new_follower']
                 && request.resource.data.link == '/u/' + request.auth.uid
                 && request.resource.data.animeId == null
                 && request.resource.data.animeTitle == null
               )
               ||
               (
                 request.resource.data.type == 'comment_like'
                 && request.resource.data.animeId is string
                 && request.resource.data.link == '/anime/' + request.resource.data.animeId
                 && isOptionalString(request.resource.data.animeTitle, 200)
               )
             );
    }

    // Validate that comment likes only toggle the current user's uid
    function isValidCommentLikeToggle() {
      let oldLiked = resource.data.likedBy is list ? resource.data.likedBy : [];
      let newLiked = request.resource.data.likedBy is list ? request.resource.data.likedBy : [];
      let oldHasCurrentUser = oldLiked.hasAny([request.auth.uid]);
      let newHasCurrentUser = newLiked.hasAny([request.auth.uid]);

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likes'])
             && request.resource.data.likes is int
             && (
               (
                 !oldHasCurrentUser
                 && newHasCurrentUser
                 && newLiked.size() == oldLiked.size() + 1
                 && request.resource.data.likes == resource.data.likes + 1
                 && newLiked.hasAll(oldLiked)
               )
               ||
               (
                 oldHasCurrentUser
                 && !newHasCurrentUser
                 && newLiked.size() == oldLiked.size() - 1
                 && request.resource.data.likes == resource.data.likes - 1
                 && oldLiked.hasAll(newLiked)
               )
             );
    }

    // Validate Integer Range
    function isValidInt(num, min, max) {
      return num is int && num >= min && num <= max;
    }

    // Validate Enum (Check if value is in a list)
    function matchesOneOf(value, options) {
      return value in options;
    }

    // Check specifically if the document itself is public (for users)
    // Note: Checks the 'isPublic' boolean field on the resource being read.
    function isResourcePublic() {
      return resource.data.isPublic != false;
    }
    
    // Check if a specific user's profile is public (requires a get() call)
    function isUserPublic(userId) {
       let userDoc = get(/databases/$(database)/documents/users/$(userId));
       return userDoc.data.isPublic != false;
    }

    // Validate date key format YYYY-MM-DD (for activityLog)
    function isValidDateKey(key) {
      return key is string && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // GET (single doc): Owner can read everything. Others can read if profile is public.
      allow get: if isOwner(userId) || isResourcePublic();
      
      // LIST (queries/search): Authenticated users can query the users collection.
      allow list: if isAuthenticated();
      
      // CREATE: Only the owner can create their profile document.
      allow create: if isOwner(userId);

      // UPDATE: only the owner can update profile data.
      allow update: if isOwner(userId)
                    && (!request.resource.data.keys().hasAny(['activityLog'])
                        || request.resource.data.activityLog is map);

      // DELETE: Only owner.
      allow delete: if isOwner(userId);

      // --- SUBCOLLECTIONS ---

      // 1. Library (Anime/Manga List)
      match /library/{docId} {
        // READ: Owner OR if Parent User Profile is Public
        allow read: if isOwner(userId) || isUserPublic(userId);
        
        // WRITE: Only Owner
        allow write: if isOwner(userId)
                     && (request.resource.data.score == null || isValidInt(request.resource.data.score, 0, 10))
                     && (request.resource.data.status == null || matchesOneOf(request.resource.data.status, ['watching', 'completed', 'plan_to_watch', 'dropped', 'paused']))
                     && (request.resource.data.currentEp == null || request.resource.data.currentEp >= 0);
      }
      
      // 2. Favorite Characters
      match /favorite_characters/{docId} {
        allow read: if isOwner(userId) || isUserPublic(userId);
        allow write: if isOwner(userId) 
                     && isValidString(request.resource.data.name, 1, 100);
      }

      // 3. Favorite studios
      match /followed_studios/{studioId} {
        allow read: if isOwner(userId) || isUserPublic(userId);
        allow create, update: if isOwner(userId) && isValidStudioFavorite(studioId);
        allow delete: if isOwner(userId);
      }

      // 4. Notifications
      // CREATE: Any authenticated user can create a notification for any user
      //         (ex: visitor sends a profile_view notif to the profile owner)
      // READ/UPDATE/DELETE: Only the owner can manage their own notifications
      match /notifications/{notifId} {
        allow create: if isValidNotificationCreate(userId);
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                      && request.resource.data.read is bool;
        allow delete: if isOwner(userId);
      }
      
      // 5. Following list (who this user follows)
      // READ: public. Writes must be atomic with the matching follower document.
      match /following/{targetUid} {
        allow read: if true;
        allow create: if isOwner(userId)
                      && targetUid != userId
                      && isValidFollowSnapshot()
                      && followPairExists(userId, targetUid);
        allow delete: if isAuthenticated()
                      && (request.auth.uid == userId || request.auth.uid == targetUid)
                      && followPairIsDeleted(userId, targetUid);
      }

      // 6. Followers list (who follows this user)
      // READ: public. Writes must be atomic with the matching following document.
      match /followers/{followerUid} {
        allow read: if true;
        allow create: if isAuthenticated()
                      && request.auth.uid == followerUid
                      && followerUid != userId
                      && isValidFollowSnapshot()
                      && followPairExists(followerUid, userId);
        allow delete: if isAuthenticated()
                      && (request.auth.uid == followerUid || request.auth.uid == userId)
                      && followPairIsDeleted(followerUid, userId);
      }

    }
    
    // --- COMMENTS --
    match /comments/{commentId} {
      // READ: Public
      allow read: if true;
      
      // CREATE: Authenticated users, MUST use their own Auth UID
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly([
                      'animeId', 'userId', 'userName',
                      'userAvatar', 'content', 'createdAt',
                      'likes', 'likedBy'
                    ])
                    && request.resource.data.animeId is string
                    && request.resource.data.userId == request.auth.uid
                    && isValidString(request.resource.data.userName, 1, 100)
                    && isOptionalString(request.resource.data.userAvatar, 2000)
                    && isValidString(request.resource.data.content, 1, 500)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.likes == 0
                    && request.resource.data.likedBy is list
                    && request.resource.data.likedBy.size() == 0;
                    
      // UPDATE:
      // a) Qualquer usuário logado pode curtir/descurtir (atualiza likedBy + likes)
      // b) Só o autor pode editar o conteúdo do comentário
      allow update: if isAuthenticated() && (
        // Like toggle: só modifica likedBy e likes, não muda userId nem content
        isValidCommentLikeToggle()
        ||
        // Edição de conteúdo: apenas o autor
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])
          && isValidString(request.resource.data.content, 1, 500)
        )
      );

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
